generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataSource {
  id            String          @id @default(uuid())
  name          String          @unique
  type          String          // 'postgres', 'api', etc.
  description   String?
  configJson    String          // JSON string with connection details
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  retentionRules RetentionRule[]

  @@map("data_sources")
}

model RetentionRule {
  id            String          @id @default(uuid())
  dataSourceId  String
  dataSource    DataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  action        String          // 'delete', 'anonymize', 'archive'
  ageDays       Int             // Age threshold in days
  filterJson    String          // JSON string with filtering logic (table, column, etc.)
  enabled       Boolean         @default(true)
  scheduleType  String          @default("daily") // 'daily', 'weekly', 'monthly'
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  retentionJobs RetentionJob[]

  @@map("retention_rules")
}

model RetentionJob {
  id            String          @id @default(uuid())
  ruleId        String
  rule          RetentionRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  status        String          // 'pending', 'running', 'completed', 'failed'
  affectedCount Int             @default(0)
  logText       String?
  errorMessage  String?
  createdAt     DateTime        @default(now())

  @@map("retention_jobs")
  @@index([ruleId])
  @@index([status])
  @@index([startedAt])
}

// Demo table for vertical slice
model Event {
  id          String   @id @default(uuid())
  eventType   String
  userId      String?
  data        String?
  createdAt   DateTime @default(now())

  @@map("events")
  @@index([createdAt])
}
